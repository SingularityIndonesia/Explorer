<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window/splash background shows before Compose draws, so match the app's surface
         colour (system neutral palette, like the dynamic Material theme) to avoid a flash. -->
    <style name="Theme.Explorer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/system_neutral1_10</item>
        <item name="android:windowSplashScreenBackground">@android:color/system_neutral1_10</item>
    </style>
</resources>
