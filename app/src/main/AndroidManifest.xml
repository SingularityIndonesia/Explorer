<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
            android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
            tools:ignore="ScopedStorage"/>
    <uses-permission
            android:name="android.permission.QUERY_ALL_PACKAGES"
            tools:ignore="QueryAllPackagesPermission"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Remote access: a socket to this phone's own Wireless debugging service (never the internet). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Remote access pairing: the code is typed into a notification while Settings stays open. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- SSH terminal: stays connected in the background (foreground service), and awake while the
         screen is off (wake lock), when the user allows it to skip battery optimization. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Copying and moving in the background, with a progress notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <!-- Playing music in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <application
            android:name=".ExplorerApp"
            android:allowBackup="true"
            android:dataExtractionRules="@xml/data_extraction_rules"
            android:fullBackupContent="@xml/backup_rules"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:supportsRtl="true"
            android:theme="@style/Theme.Explorer">
        <activity
                android:name=".MainActivity"
                android:exported="true"
                android:label="@string/app_name"
                android:theme="@style/Theme.Explorer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Open with Explorer": shows the folder containing the file (or the folder itself). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="file"/>
                <data android:scheme="content"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>

        <!-- Remote control of another Android device: its own task (one per device), so it can sit
             next to Explorer in split screen or float as picture-in-picture. configChanges keeps the
             stream running through rotation and PiP resizing. -->
        <activity
                android:name=".RemoteControlActivity"
                android:exported="false"
                android:label="Remote control"
                android:taskAffinity="com.singularity_universe.explorer.remote"
                android:documentLaunchMode="intoExisting"
                android:resizeableActivity="true"
                android:supportsPictureInPicture="true"
                android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
                android:theme="@style/Theme.Explorer"/>

        <!-- SSH terminal: its own task (one per server) holding its own SSH session. configChanges
             keeps the screen and the session through rotation, resizing and keyboards. -->
        <activity
                android:name=".SSHTerminalActivity"
                android:exported="true"
                android:label="Terminal"
                android:taskAffinity="com.singularity_universe.explorer.terminal"
                android:documentLaunchMode="intoExisting"
                android:resizeableActivity="true"
                android:windowSoftInputMode="adjustResize|stateAlwaysVisible"
                android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
                android:theme="@style/Theme.Explorer">
            <!-- Open an SSH terminal from an ssh://user@host:port link (browser, QR code, launcher
                 shortcut, another app, or `am start`). It opens the matching saved server. -->
            <intent-filter android:label="SSH terminal">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="ssh"/>
            </intent-filter>
        </activity>

        <activity
                android:name=".ImageEditorActivity"
                android:exported="false"
                android:label="Edit picture"
                android:windowSoftInputMode="adjustResize"
                android:theme="@style/Theme.Explorer"/>

        <activity
                android:name=".VideoEditorActivity"
                android:exported="false"
                android:label="Edit video"
                android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
                android:theme="@style/Theme.Explorer"/>

        <!-- Text editor: adjustResize keeps the cursor above the keyboard. -->
        <activity
                android:name=".TextEditorActivity"
                android:exported="false"
                android:label="Edit"
                android:windowSoftInputMode="adjustResize"
                android:theme="@style/Theme.Explorer"/>

        <!-- Audio playback: exported so the system's media controls (notification, lock screen,
             Bluetooth) can reach the session. -->
        <service
                android:name=".audio.PlaybackService"
                android:exported="true"
                android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService"/>
            </intent-filter>
        </service>

        <service
                android:name=".data.VideoExportService"
                android:exported="false"
                android:foregroundServiceType="dataSync"/>

        <service
                android:name=".data.TransferService"
                android:exported="false"
                android:foregroundServiceType="dataSync"/>

        <service
                android:name=".remote.TerminalService"
                android:exported="false"
                android:foregroundServiceType="specialUse">
            <property
                    android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                    android:value="Keeps the user's interactive SSH terminal sessions connected while the app is in the background."/>
        </service>

        <receiver
                android:name=".remote.PairingReceiver"
                android:exported="false"/>

        <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
            <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths"/>
        </provider>
    </application>

</manifest>